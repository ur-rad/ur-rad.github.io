---
import { Image } from "astro:assets";

export interface Props {
  photo: ImageMetadata;
  name: string;
  title: string;
  affiliation: string;
  /** Personal/faculty page. When set, the name links to it. */
  website?: string | undefined;
  alt?: string;
}

const { photo, name, title, affiliation, website, alt = name } = Astro.props;
---

<div class="p-4 sm:p-6 border border-color-300 rounded-lg text-center">
  {/* Rendered at w-28 (112px); 224px is 2x for retina. `fit="cover"` makes
      Astro emit a genuinely square variant by centre-cropping, which matters
      because not every headshot source is square — without it the generated
      file keeps the source aspect while the width/height attributes still
      claim a square, and the short side ends up upscaled. Centre-cropping
      here matches what object-cover was doing in CSS anyway. */}
  <Image
    src={photo}
    alt={alt}
    width={224}
    height={224}
    fit="cover"
    class="w-28 h-28 rounded-full mx-auto mb-4 object-cover"
  />
  <h3 class="text-lg sm:text-xl font-semibold mb-2">
    {
      website ? (
        <a
          href={website}
          target="_blank"
          rel="noopener noreferrer"
          class="text-inherit no-underline hover:underline focus-visible:underline underline-offset-2"
        >
          {name}
        </a>
      ) : (
        name
      )
    }
  </h3>
  <p class="text-sm sm:text-base text-accent-two mb-2">{title}</p>
  <p class="text-xs sm:text-sm text-lighter">{affiliation}</p>
</div>
