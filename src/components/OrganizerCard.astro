---
import { Image } from "astro:assets";

export interface Props {
  photo: ImageMetadata;
  name: string;
  affiliation: string;
  alt?: string;
}

const { photo, name, affiliation, alt = name } = Astro.props;
---

<div class="p-3 sm:p-4 border border-color-300 rounded-lg text-center">
  {
    /* Rendered at w-24 (96px); 192px is 2x for retina. `fit="cover"` centre-crops
      to a true square so non-square sources (laura-hiatt.jpg is 263x231) are
      not upscaled on their short side and the width/height attributes stay
      honest. */
  }
  <Image
    src={photo}
    alt={alt}
    width={192}
    height={192}
    fit="cover"
    class="w-24 h-24 rounded-full mx-auto mb-3 object-cover"
  />
  <h3 class="text-base sm:text-lg font-semibold mb-1">{name}</h3>
  <p class="text-xs sm:text-sm text-accent-two">{affiliation}</p>
</div>
